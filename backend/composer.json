{
    "name": "vlab/solicitacoes-atendimento",
    "description": "Sistema de Solicitações de Atendimento - Desafio Técnico V-LAB",
    "type": "project",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^11.0",
        "laravel/tinker": "^2.9",
        "laravel/sanctum": "^4.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.13",
        "mockery/mockery": "^1.6",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-install-cmd": [
            "@php artisan key:generate --ansi --no-interaction"
        ],
        "test": "./vendor/bin/pest",
        "lint": "./vendor/bin/pint"
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "policy": {
            "advisories": {
                "ignore-id": {
                    "PKSA-m5cs-t1y6-qpcs": {
                        "on-audit": false,
                        "reason": "Laravel 11 has no patched release for the temporary signed URL advisory; keep reporting it in composer audit."
                    },
                    "PKSA-3r5d-mb8f-1qw9": {
                        "on-audit": false,
                        "reason": "Laravel 11 has no patched release for the email-rule CRLF advisory; keep reporting it in composer audit."
                    },
                    "PKSA-mdq4-51ck-6kdq": {
                        "on-audit": false,
                        "reason": "Duplicate CVE-linked advisory for Laravel 11 email-rule CRLF; keep reporting it in composer audit."
                    }
                }
            }
        }
    }
}
