<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!--
            force="true" é obrigatório aqui: docker-compose.yml define APP_ENV e
            DB_CONNECTION como variáveis de ambiente reais do container (backend.environment).
            Sem force, o <env> do PHPUnit NUNCA sobrescreve uma variável de ambiente já
            definida pelo processo — então os testes rodavam silenciosamente com
            APP_ENV=local e DB_CONNECTION=pgsql, e RefreshDatabase limpava o banco de
            desenvolvimento (vlab) a cada execução, em vez do banco de teste (vlab_test).
        -->
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="CACHE_DRIVER" value="array" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="DB_CONNECTION" value="pgsql_test" force="true"/>
    </php>
</phpunit>
