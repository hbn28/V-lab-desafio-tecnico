APP_NAME="Solicitacoes de Atendimento"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=database
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:8000

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=vlab
DB_USERNAME=vlab
DB_PASSWORD=secret
DB_DATABASE_TEST=vlab_test

FRONTEND_URL=http://localhost:5173

# Fuso operacional da agenda (deve coincidir com VITE_AGENDAMENTO_TIMEZONE no frontend)
AGENDAMENTO_TIMEZONE=America/Recife

APP_SEED=false

# Cadastro público de atendentes (desative para criar contas só por operadores:criar)
CADASTRO_PUBLICO=true

# Credenciais fictícias opcionais apenas para desenvolvimento local (não versionar valores)
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_ATTENDANT_EMAIL=
DEMO_ATTENDANT_PASSWORD=
